# .env.example
# ---------------------------------------------------------------------------
# Plantilla pública del .env. SÍ se sube a GitHub.
# Cualquiera que clone el proyecto debe copiar este archivo, renombrarlo
# a ".env" y completar sus propios valores.
#   Windows (PowerShell):  copy .env.example .env
#   Linux / Mac:           cp .env.example .env
#
# IMPORTANTE: el .env real NUNCA se sube a Git (está en .gitignore).
# Usá contraseñas largas y distintas entre sí. Si ya creaste la base con
# otras claves, cambiarlas acá NO las cambia dentro de MySQL: hay que
# recrear la base con "docker compose down -v" (borra los datos).
# ---------------------------------------------------------------------------

# Clave del superusuario "root" de MySQL (la usa también phpMyAdmin)
MYSQL_ROOT_PASSWORD=cambiar_esto

# Nombre de la base de datos que crea Docker la primera vez
MYSQL_DATABASE=fixnow

# Usuario y clave con los que se conecta la aplicación PHP
MYSQL_USER=cambiar_esto
MYSQL_PASSWORD=cambiar_esto
